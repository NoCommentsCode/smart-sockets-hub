# Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-random-hex
# Должен совпадать с API_KEY в config.py прошивки ESP32!
DEVICE_API_KEY=your-secret-api-key-change-this
DATABASE_URL=sqlite+aiosqlite:///./data/hub.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login
# Подсеть для скана. Пусто = автоопределение /24 от основного интерфейса
# SCAN_CIDR=192.168.1.0/24
SCAN_INTERVAL_SECONDS=300
POLL_INTERVAL_SECONDS=10